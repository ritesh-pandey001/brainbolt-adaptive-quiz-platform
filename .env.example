# ──────────────────────────────────────────────
# BrainBolt — Environment Variables
# Copy to .env and adjust values for your setup
# Usage:  docker-compose up --build
# ──────────────────────────────────────────────

# Database
DATABASE_URL=postgresql://brainbolt:brainbolt123@postgres:5432/brainbolt
POSTGRES_USER=brainbolt
POSTGRES_PASSWORD=brainbolt123
POSTGRES_DB=brainbolt

# Redis
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# Backend
NODE_ENV=production
PORT=3001
API_VERSION=v1

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Cache
CACHE_TTL_SECONDS=300
LEADERBOARD_TOP_N=100

# Adaptive Algorithm
MIN_DIFFICULTY=1
MAX_DIFFICULTY=10
CONFIDENCE_BUFFER_SIZE=2
INACTIVITY_DECAY_MINUTES=30
MAX_STREAK_MULTIPLIER=2.0
STREAK_MULTIPLIER_RATE=0.1
