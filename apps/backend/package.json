{
  "name": "@brainbolt/backend",
  "version": "1.0.0",
  "description": "BrainBolt Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate deploy && prisma generate && npm run prisma:seed",
    "test:concurrency": "tsx ../../scripts/concurrency-test.ts",
    "test:atomicity": "tsx ../../scripts/atomicity-test.ts",
    "test:integration": "npm run test:concurrency && npm run test:atomicity",
    "verify:production": "npm run type-check && npm run build && npm run test:integration"
  },
  "dependencies": {
    "@brainbolt/shared": "file:../../packages/shared",
    "@fastify/cors": "^8.5.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^7.2.4",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.8.1",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.1",
    "fastify": "^4.25.2",
    "ioredis": "^5.3.2",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.11.0",
    "prisma": "^5.8.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
